# Whitelist ClientApp source code while ignoring node_modules and build artifacts
!AppAngular/
!AppAngular/src/
!AppAngular/src/**
!AppAngular/angular.json
!AppAngular/package.json
!AppAngular/package-lock.json
!AppAngular/tsconfig.json
!AppAngular/tsconfig.app.json
!AppAngular/tsconfig.spec.json
!AppAngular/.gitignore
!AppAngular/README.md

# But still ignore build artifacts
AppAngular/dist/
AppAngular/node_modules/
AppAngular/.angular/
AppAngular/out-tsc/
