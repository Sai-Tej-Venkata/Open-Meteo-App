<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Weather_API</RootNamespace>
    <UserSecretsId>73639061-beb5-493f-822c-aa58d152be8e</UserSecretsId>
    <DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Root folder for the Angular client app -->
    <SpaRoot>ClientApp\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.0" />
  </ItemGroup>

  <!-- Disable implicit Content items to avoid duplicate Content errors for ClientApp files -->
  <PropertyGroup>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <!-- Include only the built Angular output in publish output -->
  <ItemGroup>
    <Content Include="ClientApp\dist\**\*.*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Build the client app during publish if package.json exists -->
  <Target Name="BuildClient" BeforeTargets="PrepareForPublish" Condition="Exists('$(SpaRoot)package.json')">
    <Message Importance="high" Text="Restoring and building SPA located at $(SpaRoot)" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

</Project>
